# The fixture servers' TLS certificate, specified rather than inherited.
#
# Every parameter here used to come from somewhere else. Postgres' certificate
# was generated by `openssl req` with only `-subj`, so the key size, digest and
# extensions came from whichever openssl.cnf the host happened to ship —
# **LibreSSL 3.3.6** on macOS against **OpenSSL 3.0.2** in the Linux container.
# MariaDB and MySQL were given no certificate at all, so each server generated
# its own with its own linked TLS library, fresh on every restart.
#
# Three TLS configurations for one test suite, none of them written down, and
# any difference between them reads as a platform bug. The client is the same on
# both platforms — NIOSSL statically vendors BoringSSL and uses neither OpenSSL
# nor SecureTransport — so the certificate was the only thing that could differ,
# and it differed three ways.
#
# A config file rather than `-addext`, because `-addext` needs OpenSSL 1.1.1 and
# the macOS system openssl is LibreSSL. This form works on both, and it puts the
# extensions in a file that is reviewed rather than in a flag that is not.

[req]
distinguished_name = dn
prompt             = no
x509_extensions    = v3

[dn]
CN = localhost

[v3]
# Self-signed and its own trust anchor: `sslmode=verify-ca` pins this very file
# as the root, which a certificate without CA:TRUE cannot serve as.
basicConstraints     = critical,CA:TRUE
keyUsage             = critical,digitalSignature,keyEncipherment,keyCertSign
# Both spellings, because the fixtures are reached as `localhost` and as
# `127.0.0.1` depending on the suite. BoringSSL does not fall back to the common
# name for hostname verification, so a certificate with no SAN cannot satisfy
# `verify-full` no matter what CN says.
subjectAltName       = DNS:localhost,IP:127.0.0.1
subjectKeyIdentifier = hash
