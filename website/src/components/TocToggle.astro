---
/**
 * Collapses the right-hand "On this page" panel and gives the width back to the page.
 *
 * The reference pages carry tables the chrome cannot afford — the locale matrix is 64 rows
 * by fourteen columns, and the panel is the worse offender on exactly those pages: the
 * matrix has one heading, so 18.75rem is spent listing a single link.
 *
 * It sits with the theme toggle rather than beside the panel it controls, because it has to
 * stay reachable once the panel is gone. The choice is remembered and applied before first
 * paint. Below 72rem Starlight does not render the panel at all, so the button is hidden
 * there rather than left to do nothing.
 */
---

<button
  type="button"
  id="toc-toggle"
  aria-pressed="false"
  aria-label="Hide table of contents"
  title="Hide table of contents"
>
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" />
    <line x1="10" y1="2.5" x2="10" y2="13.5" />
  </svg>
</button>

<script is:inline>
  ;(() => {
    const KEY = 'swizzle:toc'
    const button = document.getElementById('toc-toggle')

    const paint = (collapsed) => {
      document.documentElement.dataset.toc = collapsed ? 'collapsed' : 'open'
      button.setAttribute('aria-pressed', String(collapsed))
      const label = `${collapsed ? 'Show' : 'Hide'} table of contents`
      button.setAttribute('aria-label', label)
      button.title = label
    }

    paint(document.documentElement.dataset.toc === 'collapsed')
    button.addEventListener('click', () => {
      const collapsed = document.documentElement.dataset.toc !== 'collapsed'
      paint(collapsed)
      try {
        collapsed ? localStorage.setItem(KEY, '1') : localStorage.removeItem(KEY)
      } catch {
        // Private browsing denies storage. The toggle still works for this page.
      }
    })
  })()
</script>

<style>
  #toc-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border: 1px solid var(--swizzle-rule);
    border-radius: 3px;
    background: none;
    color: var(--swizzle-faint);
    cursor: pointer;
  }
  #toc-toggle:hover {
    color: var(--swizzle-accent);
    border-color: var(--swizzle-accent);
  }
  #toc-toggle[aria-pressed='true'] {
    color: var(--swizzle-accent);
    background: var(--swizzle-accent-soft);
    border-color: var(--swizzle-accent);
  }
  #toc-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }
  @media (max-width: 72rem) {
    #toc-toggle { display: none; }
  }
</style>
